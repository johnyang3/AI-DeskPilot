<Window x:Class="DeskPilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskPilot" Width="1020" Height="760"
        MinWidth="880" MinHeight="640"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <TabControl x:Name="MainTabs" Margin="12">

        <!-- 批量解压 -->
        <TabItem x:Name="TabArchives">
            <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="btnAddArchives" Content="添加压缩包" />
                    <Button x:Name="btnRemoveArchives" Content="移除所选项" />
                    <Button x:Name="btnChooseOutput" Content="选择输出目录" />
                    <Button x:Name="btnExtract" Content="开始解压" />
                </StackPanel>
                <ListBox x:Name="lstArchives" Height="200" SelectionMode="Extended" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="输出目录" Margin="0,0,8,0" />
                    <TextBox x:Name="txtOutput" Grid.Column="1" VerticalAlignment="Center" IsReadOnly="True" />
                </Grid>
                <TextBox x:Name="txtArchiveLog" Height="150" Margin="0,8,0,0" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </TabItem>

        <!-- 桌面整理 -->
        <TabItem x:Name="TabDesktop">
            <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="btnPreviewOrganize" Content="预览整理" />
                    <Button x:Name="btnApplyOrganize" Content="执行整理" />
                    <Button x:Name="btnUndoOrganize" Content="撤销上次整理" />
                </StackPanel>
                <TextBlock x:Name="lblDesktopHint" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#555" />
                <TextBox x:Name="txtDesktopPlan" Height="360" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </TabItem>

        <!-- 清理助手 -->
        <TabItem x:Name="TabCleanup">
            <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="btnScan" Content="扫描清理候选" />
                    <Button x:Name="btnCleanSelected" Content="移除/卸载所选" />
                </StackPanel>
                <TextBlock x:Name="lblCleanupHint" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#555" />
                <ListView x:Name="lstCandidates" Height="380">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="40" Header="选择">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="220" Header="名称" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Width="120" Header="类型" DisplayMemberBinding="{Binding Kind}" />
                            <GridViewColumn Width="120" Header="大小" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Width="260" Header="匹配原因" DisplayMemberBinding="{Binding Reason}" />
                            <GridViewColumn Width="300" Header="路径" DisplayMemberBinding="{Binding Path}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </TabItem>

        <!-- AI 管理 -->
        <TabItem x:Name="TabAssistant">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="txtChat" Grid.Row="0" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtUserInput" Grid.Column="0" Height="60" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,8,0" />
                    <Button x:Name="btnSend" Grid.Column="1" Content="发送" Width="100" Height="60" />
                </Grid>
            </Grid>
        </TabItem>

        <!-- 设置与更新 -->
        <TabItem x:Name="TabSettings">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="OpenAI 兼容接口" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="txtEndpoint" Margin="0,0,0,8" />
                    <TextBlock Text="模型" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="txtModel" Margin="0,0,0,8" />
                    <TextBlock Text="API 密钥" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <PasswordBox x:Name="txtApiKey" Margin="0,0,0,8" />
                    <Button x:Name="btnSaveAi" Content="加密保存设置" HorizontalAlignment="Left" Margin="0,0,0,16" />

                    <TextBlock Text="受保护路径（每行一个）" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="txtProtectedPaths" Height="120" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />
                    <Button x:Name="btnSaveProtection" Content="保存保护规则" HorizontalAlignment="Left" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="btnCheckUpdate" Content="检查并安装更新" />
                        <Button x:Name="btnOpenRepo" Content="打开 GitHub 仓库" />
                    </StackPanel>
                    <TextBlock x:Name="txtVersion" Margin="0,8,0,0" Foreground="#555" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>
